{
  "name": "void-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "prepare:types": "void prepare && node --input-type=module -e \"import { resolveConfig } from 'vite'; await resolveConfig({}, 'build')\"",
    "typecheck": "pnpm run prepare:types && vue-tsc --noEmit",
    "test": "vp test",
    "fmt": "vp fmt",
    "deploy": "void deploy --platform cloudflare",
    "preview": "vp preview",
    "postinstall": "pnpm run prepare:types"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.160",
    "@nuxt/ui": "^4.13.1",
    "@void/vue": "1.12.1",
    "@vueuse/core": "^15.1.0",
    "vue": "^3.5.46",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0",
    "void": "1.12.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^24.22.0 || >=26.12.0"
  },
  "packageManager": "pnpm@12.23.0"
}
