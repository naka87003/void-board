{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "@cloudflare/workers-types"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "shared", "routes", ".void/**/*.d.ts", "vite.config.ts", "void.config.ts"]
}
